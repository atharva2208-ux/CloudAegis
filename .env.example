# ---------------------------------------------------------------------------
# CloudAegis configuration. Copy to .env and adjust. Every variable is optional
# for local use; production requires SECRET_KEY, CREDENTIAL_ENCRYPTION_KEY and
# COOKIE_SECURE=true (the API refuses to start otherwise).
# Generate secrets with:  ./scripts/generate-secrets.sh
# ---------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development

# Database (docker compose builds DATABASE_URL from these)
POSTGRES_USER=cloudaegis
POSTGRES_PASSWORD=cloudaegis
POSTGRES_DB=cloudaegis
# When running the API outside docker:
# DATABASE_URL=postgresql+psycopg2://cloudaegis:cloudaegis@localhost:5432/cloudaegis
# REDIS_URL=redis://localhost:6379/0

# Signs session tokens (>= 32 random characters in production)
SECRET_KEY=
# Fernet key that encrypts stored cloud credentials at rest
CREDENTIAL_ENCRYPTION_KEY=

# Sessions
COOKIE_SECURE=false            # true behind HTTPS (required in production)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=480

# Abuse protection
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=600
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Scanning: inprocess (single node) | rq (Redis queue + worker container)
SCAN_EXECUTOR=rq
SCAN_WORKERS=2
SCAN_TIMEOUT_SECONDS=3600

# Demo mode seeds a clearly labelled simulated AWS account and demo users
DEMO_MODE=true
SEED_ADMIN_EMAIL=admin@cloudaegis.local
# Leave empty in demo mode to use the published demo password; set for real use
SEED_ADMIN_PASSWORD=

# AWS: CloudAegis' own identity, used only for sts:AssumeRole into audited
# accounts. Prefer an EC2 instance profile / ECS task role over static keys.
PLATFORM_AWS_PRINCIPAL_ARN=
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
